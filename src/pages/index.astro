---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Promos from '../components/Promos.astro';
import Features from '../components/Features.astro';
import Gift from '../components/Gift.astro';
import Era from '../components/Era.astro';
import Principles from '../components/Principles.astro';
import StayCurious from '../components/StayCurious.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<BaseLayout
