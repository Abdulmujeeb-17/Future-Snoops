---
/*
  Header: wordmark left, "Menu" right (Figma 72:211 / 72:212). It stays fixed to the top
  of the screen: plain white over the photo sections (marked data-header-dark) and the
  open menu, and white with a difference blend elsewhere, so it inverts against whatever
  it passes over (dark on the peach page, light over photos inside cards).

  The menu copies the motion of asake.framer.website (measured frame by frame):
  - open: a black panel drops from the top in 400ms (strong ease-in-out) while the page
    behind dims to 80% black; once it lands, the links drop 40px into place and fade in,
    45ms apart, over 650ms with a soft ease-out.
  - close: the panel lifts away in 400ms while the links fade out upwards in turn.
  Links are grey and turn white on hover; social links sit top-left, a tagline bottom-left.

  "Request a Demo" and "Log in" (destinations from the live site's navbar) sit beside
  Menu from tablet up, on their own unblended layer so their colours stay true. On phones
  they move into the open menu.
*/
import Button from './Button.astro';
import { links } from '../data/links';

const site = 'https://www.futuresnoops.com/en';

const menuItems = [
  { label: 'About', href: `${site}/about` },
  { label: 'Platform', href: `${site}/platform` },
  { label: 'Advisory', href: `${site}/advisory` },
  { label: 'Pricing', href: `${site}/pricing` },
  { label: 'Events', href: `${site}/events` },
  { label: 'Discover', href: `${site}/discover` },
];

const socials = [
  { label: 'Instagram', href: 'https://www.instagram.com/fashionsnoops/' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/company/future-snoops' },
  { label: 'YouTube', href: 'https://www.youtube.com/@Future_Snoops' },
  { label: 'Pinterest', href: 'https://uk.pinterest.com/future_snoops/' },
];
---

<header class="header" data-site-header>
  <div class="bar">
  <a class="brand" href="/" aria-label="Future Snoops, home">Future Snoops</a>

  <button
    class="toggle"
    type="button"
    aria-expanded="false"
    aria-controls="site-menu"
    data-menu-toggle
  >
    <span class="toggle__label toggle__label--open">Menu</span>
    <span class="toggle__label toggle__label--close" aria-hidden="true">Close</span>
  </button>
  </div>

  <div class="actions-bar">
    <div class="actions">
      <a class="nav-btn nav-btn--lime" href={links.requestDemo} target="_blank" rel="noopener noreferrer">Request a Demo</a>
      <a class="nav-btn nav-btn--white" href={links.login} target="_blank" rel="noopener noreferrer">Log in</a>
    </div>
  </div>

  <div class="menu" id="site-menu" data-menu hidden>
    <div class="menu__backdrop" data-menu-backdrop></div>
    <div class="menu__panel" data-menu-panel>
      <div class="menu__aside">
        <ul class="menu__socials" aria-label="Social">
          {
            socials.map((item) => (
              <li>
                <a href={item.href} target="_blank" rel="noopener noreferrer">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <p class="menu__tagline">A conversational, AI-powered intelligence platform built for creators.</p>
      </div>

      <div class="menu__ctas">
        <Button tone="lime" href={links.requestDemo}>Request a Demo</Button>
        <Button href={links.login}>Log in</Button>
      </div>

      <nav class="menu__nav" aria-label="Primary">
        <ul>
          {
            menuItems.map((item, index) => (
              <li style={`--i:${index}`}>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = header?.querySelector<HTMLElement>('[data-menu]');
  const panel = header?.querySelector<HTMLElement>('[data-menu-panel]');
  const backdrop = header?.querySelector<HTMLElement>('[data-menu-backdrop]');

  if (header && toggle && menu && panel && backdrop) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const isOpen = () => header.hasAttribute('data-open');

    const focusables = () => [toggle, ...menu.querySelectorAll<HTMLElement>('a[href]')];

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.querySelector('.toggle__label--open')?.setAttribute('aria-hidden', String(open));
      toggle.querySelector('.toggle__label--close')?.setAttribute('aria-hidden', String(!open));
      document.body.toggleAttribute('data-menu-open', open);

      if (open) {
        menu.hidden = false;
        // Two frames: the panel must render in its start position before it can animate.
        requestAnimationFrame(() =>
          requestAnimationFrame(() => header.setAttribute('data-open', '')),
        );
        menu.querySelector<HTMLElement>('.menu__nav a')?.focus({ preventScroll: true });
      } else {
        header.removeAttribute('data-open');
        if (reducedMotion.matches) menu.hidden = true;
      }
    };

    panel.addEventListener('transitionend', (event) => {
      if (event.target === panel && event.propertyName === 'transform' && !isOpen()) {
        menu.hidden = true;
      }
    });

    // Switch the header to dark text whenever it is not over a photo section.
    const darkSections = [...document.querySelectorAll<HTMLElement>('[data-header-dark]')];
    let queued = false;
    const updateTone = () => {
      queued = false;
      const probe = toggle.getBoundingClientRect();
      const y = probe.top + probe.height / 2;
      const overDark = darkSections.some((section) => {
        const rect = section.getBoundingClientRect();
        return rect.top <= y && rect.bottom >= y;
      });
      header.toggleAttribute('data-on-light', !overDark);
    };
    const queueTone = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(updateTone);
    };
    window.addEventListener('scroll', queueTone, { passive: true });
    window.addEventListener('resize', queueTone);
    updateTone();

    toggle.addEventListener('click', () => setOpen(!isOpen()));
    backdrop.addEventListener('click', () => setOpen(false));

    document.addEventListener('keydown', (event) => {
      if (!isOpen()) return;
      if (event.key === 'Escape') {
        setOpen(false);
        toggle.focus();
      }
      // Keep keyboard focus inside the open menu.
      if (event.key === 'Tab') {
        const items = focusables();
        const first = items[0];
        const last = items[items.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    });
  }
</script>

<style>
  .header {
    --toggle-size: 22px;
    --row-h: 32px;
    --menu-ease: cubic-bezier(0.76, 0, 0.24, 1);
    --menu-ease-out: cubic-bezier(0.22, 1, 0.36, 1);
    --menu-grey: #6f6f6f;
  }

  /*
    The bar and the menu are separate fixed layers: a blend mode only mixes with what is
    behind its own layer, so the bar must not contain the menu panel.
  */
  .bar {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 16px 0 16px;
    color: var(--color-white);
    /* The bar spans the page; only its controls take clicks. */
    pointer-events: none;
  }

  .header[data-on-light] .bar {
    mix-blend-mode: difference;
  }

  .brand,
  .toggle,
  .menu,
  .actions {
    pointer-events: auto;
  }

  /* ---------- Request a Demo / Log in ---------- */

  .actions-bar {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    display: none;
    justify-content: flex-end;
    padding: 24px 16px 0;
    pointer-events: none;
    transition:
      opacity 300ms ease,
      visibility 300ms;
  }

  /* Hidden while the menu is open; the panel has its own copy on phones. */
  .header[data-open] .actions-bar {
    opacity: 0;
    visibility: hidden;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: var(--row-h);
    /* Clear the Menu/Close label, which has a fixed width. */
    margin-right: calc(var(--toggle-size) * 2.4 + 24px);
  }

  .nav-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 40px;
    padding: 0 18px;
    overflow: hidden;
    isolation: isolate;
    border-radius: var(--radius-sm);
    color: var(--color-ink);
    font-size: 15px;
    letter-spacing: -0.02em;
    white-space: nowrap;
    transition:
      transform 400ms var(--ease-out),
      box-shadow 400ms var(--ease-out);
  }

  .nav-btn--lime {
    background: var(--color-lime);
    color: var(--color-ink-soft);
  }

  .nav-btn--white {
    background: var(--color-white);
  }

  .nav-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(0 0 0 / 0.08);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 450ms var(--ease-out);
  }

  @media (hover: hover) {
    .nav-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 24px -14px rgb(0 0 0 / 0.55);
    }

    .nav-btn:hover::before {
      transform: scaleY(1);
    }
  }

  .menu__ctas {
    display: flex;
    flex-direction: column;
    gap: 12px;
    order: 1;
    transition: opacity 400ms var(--menu-ease-out);
  }

  .header:not([data-open]) .menu__ctas {
    opacity: 0;
  }

  .header[data-open] .menu__ctas {
    transition-delay: 450ms;
  }

  .brand,
  .toggle {
    position: relative;
    font-family: var(--font-display);
    white-space: nowrap;
  }

  .brand {
    font-size: 24px;
    line-height: 32px;
  }

  .toggle {
    display: grid;
    justify-items: end;
    width: calc(var(--toggle-size) * 2.4);
    padding: 0;
    border: 0;
    background: none;
    font-size: 22px;
    line-height: 30px;
    cursor: pointer;
  }

  .toggle__label {
    grid-area: 1 / 1;
    text-align: right;
    transition:
      opacity 300ms var(--ease-out),
      translate 400ms var(--ease-out);
  }

  .toggle__label--close {
    opacity: 0;
    translate: 0 40%;
  }

  .header[data-open] .toggle__label--open {
    opacity: 0;
    translate: 0 -40%;
  }

  .header[data-open] .toggle__label--close {
    opacity: 1;
    translate: none;
  }

  /* Underline that draws in on hover. */
  .brand::after,
  .toggle::after {
    content: '';
    position: absolute;
    inset: auto 0 -2px;
    height: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 450ms var(--ease-out);
  }

  @media (hover: hover) {
    .brand:hover::after,
    .toggle:hover::after {
      transform: scaleX(1);
      transform-origin: left;
    }
  }

  /* ---------- Menu ---------- */

  .menu {
    position: fixed;
    inset: 0;
    z-index: 49;
  }

  .menu__backdrop {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.8);
    opacity: 0;
    transition: opacity 400ms var(--menu-ease);
  }

  .menu__panel {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 40px;
    max-height: 100%;
    padding: 88px 16px 40px;
    overflow-y: auto;
    background: #000;
    color: var(--color-white);
    transform: translateY(-100%);
    transition: transform 400ms var(--menu-ease);
  }

  .header[data-open] .menu__backdrop {
    opacity: 1;
  }

  .header[data-open] .menu__panel {
    transform: none;
  }

  /* Links: closing state and timing first, then the open state and its timing. */
  .menu__nav li {
    opacity: 0;
    transform: translateY(-40px);
    transition:
      opacity 400ms var(--menu-ease-out),
      transform 400ms var(--menu-ease-out);
    transition-delay: calc(150ms + var(--i) * 50ms);
  }

  .header[data-open] .menu__nav li {
    opacity: 1;
    transform: none;
    transition-duration: 650ms;
    transition-delay: calc(300ms + var(--i) * 45ms);
  }

  .menu__nav a {
    display: inline-block;
    color: var(--color-white);
    font-family: var(--font-display);
    font-size: clamp(52px, 15vw, 72px);
    line-height: 0.98;
    text-transform: uppercase;
    transition: color 250ms ease;
  }

  .menu__aside {
    display: flex;
    flex-direction: column;
    gap: 24px;
    order: 2;
    color: var(--menu-grey);
    font-size: 16px;
    line-height: 1.15;
    transition: opacity 400ms var(--menu-ease-out);
  }

  .header:not([data-open]) .menu__aside {
    opacity: 0;
  }

  .header[data-open] .menu__aside {
    transition-delay: 450ms;
  }

  .menu__socials a {
    transition: color 250ms ease;
  }

  .menu__tagline {
    max-width: 260px;
    color: var(--color-white);
    text-transform: uppercase;
  }

  @media (hover: hover) {
    .menu__nav a {
      color: var(--menu-grey);
    }

    .menu__nav a:hover,
    .menu__nav a:focus-visible,
    .menu__socials a:hover {
      color: var(--color-white);
    }

    .menu__tagline {
      color: var(--menu-grey);
    }
  }

  @media (min-width: 768px) {
    .header {
      --toggle-size: 30px;
      --row-h: 44.8px;
    }

    .bar,
    .actions-bar {
      padding: 32px 32px 0;
    }

    .actions-bar {
      display: flex;
    }

    .menu__ctas {
      display: none;
    }

    .brand {
      font-size: 32px;
      line-height: 1.4;
    }

    .toggle {
      font-size: 30px;
      line-height: 1.4;
    }

    /* Two columns: details on the left, links from 45% across. */
    .menu__panel {
      display: grid;
      grid-template-columns: 45% 1fr;
      gap: 0;
      padding: 104px 32px 84px;
    }

    .menu__aside {
      order: 0;
      justify-content: space-between;
    }

    .menu__nav a {
      font-size: 96px;
      line-height: 0.92;
    }
  }

  @media (min-width: 1024px) {
    .header {
      --toggle-size: calc(40 * var(--anton) * var(--s));
      --row-h: calc(58 * var(--s));
    }

    .bar,
    .actions-bar {
      padding: calc(46 * var(--s)) 80px 0;
    }

    .actions {
      gap: calc(12 * var(--s));
    }

    .nav-btn {
      height: max(38px, calc(48 * var(--s)));
      padding: 0 calc(22 * var(--s));
      font-size: max(13px, calc(17 * var(--s)));
    }

    .brand,
    .toggle {
      font-size: calc(40 * var(--anton) * var(--s));
      line-height: calc(58 * var(--s));
    }

    .menu__panel {
      padding: calc(130 * var(--s)) 80px calc(84 * var(--s));
    }

    .menu__aside {
      font-size: max(14px, calc(18 * var(--s)));
    }

    .menu__tagline {
      max-width: calc(300 * var(--s));
    }

    .menu__nav a {
      font-size: calc(118 * var(--s));
      line-height: calc(106 * var(--s));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu__backdrop,
    .menu__panel,
    .menu__nav li,
    .menu__aside,
    .toggle__label {
      transition: none !important;
    }
  }
</style>
