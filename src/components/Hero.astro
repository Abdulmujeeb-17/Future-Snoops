---
/*
  Hero (Figma 67:118 desktop 1600x1049, 107:224 mobile 390x595), stretched to fill the
  viewport. The photo covers the hero, positioned to keep the Figma crop of the face.
  Text positions are the Figma positions as percentages of the frame height.
*/
import { Image } from 'astro:assets';
import heroImage from '../assets/home/hero.png';
---

<section class="hero" aria-labelledby="hero-title" data-header-dark>
  <div class="hero__media" aria-hidden="true">
    <Image
      class="hero__image"
      src={heroImage}
      alt=""
      widths={[700, 1100, 1600, 2000]}
      sizes="(max-width: 767px) 170vw, 100vw"
      format="webp"
      quality={78}
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <p class="hero__statement hero__statement--left">The New Future Snoops Experience</p>
  <p class="hero__statement hero__statement--right">A conversational, AI-powered intelligence platform</p>

  <h1 class="hero__title" id="hero-title">
    <span class="hero__title-line">Future Snoops</span>
  </h1>
</section>

<style>
  .hero {
    position: relative;
    height: 100vh;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    background: var(--color-signal);
    color: var(--color-white);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    background: #ffa582;
  }

  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.46);
  }

  .hero__media :global(.hero__image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 35%;
  }

  .hero__statement {
    position: absolute;
    font-size: 20px;
    font-weight: 700;
    line-height: 28px;
    letter-spacing: -0.02em;
  }

  .hero__statement--left {
    left: 16px;
    top: 48.74%;
    width: 280px;
  }

  .hero__statement--right {
    right: 16px;
    top: 65.38%;
    width: 320px;
    text-align: right;
  }

  .hero__title {
    position: absolute;
    inset: auto 16px 12px;
    font-family: var(--font-display);
    font-size: 62px;
    line-height: 68px;
    text-align: center;
    white-space: nowrap;
  }

  .hero__title-line {
    display: block;
  }

  /* Tablet: the mobile composition, with the photo widened to the viewport. */
  @media (min-width: 768px) {
    .hero {
      min-height: 640px;
    }

    .hero__media::after {
      background: rgb(0 0 0 / 0.38);
    }

    .hero__statement {
      font-size: 26px;
      line-height: 1.3;
    }

    .hero__statement--left {
      left: 32px;
      top: 30%;
      width: 380px;
    }

    .hero__statement--right {
      right: 32px;
      top: 46%;
      width: 420px;
    }

    .hero__title {
      inset-inline: 32px;
      bottom: 24px;
      /* "Future Snoops" in Anton is about 5.7em wide; fit it between the gutters. */
      font-size: calc((100vw - 64px) / 5.8);
      line-height: 1;
    }
  }

  /*
    Desktop: 80px side padding. The statements sit on it and the "Future Snoops" title
    spans the full width between it.
  */
  @media (min-width: 1024px) {
    .hero {
      --hero-pad: 80px;
      min-height: calc(640 * var(--s));
      container-type: inline-size;
    }

    .hero__media :global(.hero__image) {
      object-position: 50% 38%;
    }

    .hero__media::after {
      background: rgb(0 0 0 / 0.33);
    }

    .hero__statement {
      font-size: calc(32 * var(--s));
      line-height: 1.3125;
    }

    .hero__statement--left {
      left: var(--hero-pad);
      top: 27.26%;
      width: calc(436 * var(--s));
    }

    .hero__statement--right {
      right: var(--hero-pad);
      top: 43.09%;
      width: calc(492 * var(--s));
    }

    /* "Future Snoops" in Anton is 5.70em wide; this fills the space between the paddings. */
    .hero__title {
      inset-inline: var(--hero-pad);
      bottom: calc(24 * var(--s));
      font-size: calc((100cqw - 2 * var(--hero-pad)) / 5.7);
      line-height: 1;
    }
  }

  /* Load-in: the photo settles, then the headline rises into place. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__media :global(.hero__image) {
      animation: settle 1800ms var(--ease-out) both;
    }

    .hero__title-line {
      animation: rise 1100ms var(--ease-out) 250ms both;
    }

    .hero__statement {
      animation: fade-up 900ms var(--ease-out) both;
    }

    .hero__statement--left {
      animation-delay: 550ms;
    }

    .hero__statement--right {
      animation-delay: 700ms;
    }

    @keyframes settle {
      from {
        transform: scale(1.06);
      }
    }

    @keyframes rise {
      from {
        clip-path: inset(-10% -5% 110% -5%);
        transform: translateY(22%);
      }
      to {
        clip-path: inset(-10% -5% -10% -5%);
        transform: none;
      }
    }

    @keyframes fade-up {
      from {
        opacity: 0;
        transform: translateY(16px);
      }
    }
  }
</style>
